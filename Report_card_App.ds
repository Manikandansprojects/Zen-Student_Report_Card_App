										ticket_html = ticket_html + "<tr style='background:#d9dee5; font-weight:bold;'>";
										ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>Total Working Days</th>";
										ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>Total Present Days</th>";
										ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>Attendance Percentage</th>";
										ticket_html = ticket_html + "</tr>";
										ticket_html = ticket_html + "<tr>";
										ticket_html = ticket_html + "<td style='border:1px solid #777; padding:8px;'>" + input.Total_working_days + "</td>";
										ticket_html = ticket_html + "<td style='border:1px solid #777; padding:8px;'>" + input.Total_days_present + "</td>";
										attendance_percentage = input.Total_days_present / input.Total_working_days * 100;
										ticket_html = ticket_html + "<td style='border:1px solid #777; padding:8px;'>" + attendance_percentage + "</td>";
										ticket_html = ticket_html + "</tr>";
										ticket_html = ticket_html + "</table>";
										list = Collection();
										if(Marks != null && Marks1 != null && Marks2 != null && Marks3 != null && Marks4 != null)
										{
											total = input.Marks + input.Marks1 + input.Marks2 + input.Marks3 + input.Marks4;
											ticket_html = ticket_html + "<p><strong>Total</strong> <span style='color:green;font-weight:bold;'>" + total + "</span></p>";
										}
										else if(Marks5 != null && Marks6 != null && Marks7 != null && Marks8 != null && Marks9 != null && Marks10 != null)
										{
											total1 = input.Marks5 + input.Marks6 + input.Marks7 + input.Marks8 + input.Marks9 + input.Marks10;
											ticket_html = ticket_html + "<p><strong>Total</strong> <span style='color:green;font-weight:bold;'>" + total1 + "</span></p>";
										}
										if(Marks >= 50 && Marks1 >= 50 && Marks2 >= 50 && Marks3 >= 50 && Marks4 >= 50)
										{
											Result = "Pass";
										}
										else if(Marks5 >= 50 && Marks6 >= 50 && Marks7 >= 50 && Marks8 >= 50 && Marks9 >= 50 && Marks10 >= 50)
										{
											Result = "Pass";
										}
										else
										{
											Result = "Fail";
										}
										ticket_html = ticket_html + "<p><strong>Result:</strong> <span style='color:green;font-weight:bold;'>" + Result + "</span></p>";
										//calculating percentage 
										if(total != null)
										{
											one = total / 5;
											ticket_html = ticket_html + "<p><strong>Percentage</strong> <span style='color:green;font-weight:bold;'>" + one + " " + "%" + "</span></p>";
										}
										else if(total1 != null)
										{
											two = total1 / 6;
											ticket_html = ticket_html + "<p><strong>Percentage</strong> <span style='color:green;font-weight:bold;'>" + two + " " + "%" + "</span></p>";
										}
										//Calculating cgpa
										if(one != null)
										{
											cgpa_for_odd_sem = one / 10;
											ticket_html = ticket_html + "<p><strong>SCGPA:</strong> <span style='color:green;font-weight:bold;'>" + cgpa_for_odd_sem + "</span></p>";
										}
										else if(two != null)
										{
											cgpa_for_even_sem = two / 10;
											ticket_html = ticket_html + "<p><strong>SCGPA:</strong> <span style='color:green;font-weight:bold;'>" + cgpa_for_even_sem + "</span></p>";
										}
										// ticket_html = ticket_html + "<p><strong>CGPA:</strong> " + input.CGPA + "</p>"; //cgpa
										// Signature Table
										ticket_html = ticket_html + "<table style='width:100%; border-collapse:collapse; font-family:Arial, sans-serif; text-align:center;'>";
										// Header Row
										ticket_html = ticket_html + "<tr style='background:#d9dee5; font-weight:bold;'>";
										ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>Class Advisor Signature</th>";
										ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>HOD Signature</th>";
										ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>Principal</th>";
										ticket_html = ticket_html + "</tr>";
										// Image Row
										ticket_html = ticket_html + "<tr>";
										ticket_html = ticket_html + "<td style='border:1px solid #333; padding:10px;'>";
										ticket_html = ticket_html + "<img src='https://signaturesideas.com/cdn/shop/products/image_e8b32f36-f4d1-43f6-8320-72828c912400.jpg?v=1706573693&width=1445' width='120' height='60' style='display:block; margin:auto;'>";
										ticket_html = ticket_html + "</td>";
										ticket_html = ticket_html + "<td style='border:1px solid #333; padding:10px;'>";
										ticket_html = ticket_html + "<img src='https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQyBkbeQdbQvfuZ-D1vBZM3ZNxxFz9hBu54dg&s' width='120' height='60' style='display:block; margin:auto;'>";
										ticket_html = ticket_html + "</td>";
										ticket_html = ticket_html + "<td style='border:1px solid #333; padding:10px;'>";
										ticket_html = ticket_html + "<img src='https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRg1l5aBSafYEW4fUnULcSkAburz2Z2bsG0NL1HGjZ-&s' width='120' height='60' style='display:block; margin:auto;'>";
										ticket_html = ticket_html + "</td>";
										ticket_html = ticket_html + "</tr>";
										ticket_html = ticket_html + "</table>";
										ticket_html = ticket_html + "</td>";
										ticket_html = ticket_html + "</tr></table>";
										ticket_html = ticket_html + "</td></tr>";
										ticket_html = ticket_html + "</table>";
										ticket_html = ticket_html + "</td></tr></table>";
										// // Signature Table
										// ticket_html = ticket_html + "<table style='width:100%; border-collapse:collapse; font-family:Arial, sans-serif; text-align:center;'>";
										// // Header Row
										// ticket_html = ticket_html + "<tr style='background:#d9dee5; font-weight:bold;'>";
										// ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>Class Advisor Signature</th>";
										// ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>HOD Signature</th>";
										// ticket_html = ticket_html + "<th style='border:1px solid #333; padding:10px;'>Principal</th>";
										// ticket_html = ticket_html + "</tr>";
										// // Image Row
										// ticket_html = ticket_html + "<tr>";
										// ticket_html = ticket_html + "<td style='border:1px solid #333; padding:10px;'>";
										// ticket_html = ticket_html + "<img src='https://static.vecteezy.com/system/resources/previews/025/866/358/non_2x/fake-autograph-samples-hand-drawn-signatures-examples-of-documents-certificates-and-contracts-with-inked-and-handwritten-lettering-vector.jpg' width='120' height='60' style='display:block; margin:auto;'>";
										// ticket_html = ticket_html + "</td>";
										// ticket_html = ticket_html + "<td style='border:1px solid #333; padding:10px;'>";
										// ticket_html = ticket_html + "<img src='https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQyBkbeQdbQvfuZ-D1vBZM3ZNxxFz9hBu54dg&s' width='120' height='60' style='display:block; margin:auto;'>";
										// ticket_html = ticket_html + "</td>";
										// ticket_html = ticket_html + "<td style='border:1px solid #333; padding:10px;'>";
										// ticket_html = ticket_html + "<img src='https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRg1l5aBSafYEW4fUnULcSkAburz2Z2bsG0NL1HGjZ-&s' width='120' height='60' style='display:block; margin:auto;'>";
										// ticket_html = ticket_html + "</td>";
										// ticket_html = ticket_html + "</tr>";
										// ticket_html = ticket_html + "</table>";
										// ticket_html = ticket_html + "</body></html>";
										info ticket_html;
										/* Send Mail */
										pdfFile1 = zoho.file.convertToPDF(ticket_html);
										info pdfFile1;
										// This creates a hidden unique timestamp that prevents Gmail trimming
										ticket_html = ticket_html + "<div style='display:none !important; font-size:1px; color:#ffffff; visibility:hidden; opacity:0;'>" + now + "</div>";
										ticket_html = ticket_html + "</body></html>";
										sendmail
										[
											from :"zentegrademo31@gmail.com"
											to :input.Student_Mail
											cc:"manikandansjobzen@gmail.com"
											reply to :"manikandan@zentegra.com"
											subject :"Your Semester Report Card"
											message :ticket_html
											Attachments :file:pdfFile1
										]
						)
					}
				}

			}
