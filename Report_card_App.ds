			Enable_select_semester as "Enable select semester"
			{
				type =  form
				form = Student_all_details

				record event = on add or edit

				on user input of Branch
				{
					actions 
					{
						custom deluge script
						(
											if(Branch == "Computer science and engineering" || Branch == "Electronics and communication engineering" || Branch == "Electrical and electronics engineering" || Branch == "Information technology" || Branch == "Mechanical engineering" || Branch == "Aeronatical engineering" || Branch == "Artificial intelligence and data science" || Branch == "Cyber security")
										{
											show Select_semester;
										}
										else
										{
											hide Select_semester;
										}
						)
					}
				}

			}
