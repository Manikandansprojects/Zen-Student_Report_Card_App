		workflow
		{
		form
		{
			Hide_fields as "Hide fields"
			{
				type =  form
				form = Student_all_details

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Branch;
										hide SubForm.Name;
										hide Select_semester;
										hide Subject_code;
										hide Subject_code1;
										hide Subject_code2;
										hide Subject_code3;
										hide Subject_code4;
										hide Subject_code5;
										hide Subject_code6;
										hide Subject_code7;
										hide Subject_code8;
										hide Subject_code9;
										hide Subject_code10;
										hide Subject_Name;
										hide Subject_name_1;
										hide Subject_name2;
										hide Subject_name3;
										hide Subject_name4;
										hide Subject_name5;
										hide Subject_name6;
										hide Subject_name7;
										hide Subject_name8;
										hide Subject_name9;
										hide Subject_name10;
										hide Marks;
										hide Marks1;
										hide Marks2;
										hide Marks3;
										hide Marks4;
										hide Marks5;
										hide Marks6;
										hide Marks7;
										hide Marks8;
										hide Marks9;
										hide Marks10;
										hide SubForm;
										hide Internal_Marks;
										hide Internal_Marks10;
										hide Internal_Marks;
										hide Internal_Marks1;
										hide Internal_Marks2;
										hide Internal_Marks3;
										hide Internal_Marks4;
										hide Internal_Marks5;
										hide Internal_Marks6;
										hide Internal_Marks7;
										hide Internal_Marks8;
										hide Internal_Marks9;
										hide Internal_Marks10;
						)
					}
				}

			}
			Show_field as "Show field"
			{
				type =  form
				form = Student_all_details

				record event = on add or edit

				on user input of Degree
				{
					actions 
					{
						custom deluge script
						(
											if(Degree == "BE" || Degree == "ME" || Degree == "BTech" || Degree == "MTech")
										{
											show Branch;
										}
										else
										{
											hide Branch;
											hide Select_semester;
										}
						)
					}
				}

			}
			Enable_the_subjects_subje as "Enable the subjects-subjectcode-marks"
			{
				type =  form
				form = Student_all_details

				record event = on add or edit
					status = inactive

				on user input of Branch
				{
					actions 
					{
						custom deluge script
						(
											if(Select_semester == "1" || Select_semester == "3" || Select_semester == "5" || Select_semester == "7")
										{
											show Subject_code;
											show Subject_code1;
											show Subject_code2;
											show Subject_code3;
											show Subject_code4;
											show Subject_Name;
											show Subject_name_1;
											show Subject_name2;
											show Subject_name3;
											show Subject_name4;
											show Marks;
											show Marks1;
											show Marks2;
											show Marks3;
											show Marks4;
										}
						)
					}
				}

			}
			Show_Subject_SubjectCode_ as "Show Subject-SubjectCode-Marks"
			{
				type =  form
				form = Student_all_details

				record event = on add or edit

				on user input of Select_semester
				{
					actions 
					{
						custom deluge script
						(
											// hide Subject_code;
										// hide Subject_Name;
										// hide Marks;
										if(Select_semester == "Semester 1" || Select_semester == "Semester  3" || Select_semester == "Semester 5" || Select_semester == "Semester 7")
										{
											show Subject_code;
											show Subject_code1;
											show Subject_code2;
											show Subject_code3;
											show Subject_code4;
											show Subject_Name;
											show Subject_name_1;
											show Subject_name2;
											show Subject_name3;
											show Subject_name4;
											show Marks;
											show Marks1;
											show Marks2;
											show Marks3;
											show Marks4;
										}
										else
