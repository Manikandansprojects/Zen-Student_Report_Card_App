											hide Subject_name4;
											hide Marks;
											hide Marks1;
											hide Marks2;
											hide Marks3;
											hide Marks4;
										}
										if(Select_semester == "Semester 2" || Select_semester == "Semester 4" || Select_semester == "Semester 6" || Select_semester == "Semester 8")
										{
											show Subject_code5;
											show Subject_code6;
											show Subject_code7;
											show Subject_code8;
											show Subject_code9;
											show Subject_code10;
											show Subject_name5;
