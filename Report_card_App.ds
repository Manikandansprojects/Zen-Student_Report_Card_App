											hide Subject_code6;
											hide Subject_code7;
											hide Subject_code8;
											hide Subject_code9;
											hide Subject_code10;
											hide Subject_name5;
											hide Subject_name6;
											hide Subject_name7;
											hide Subject_name8;
											hide Subject_name9;
											hide Subject_name10;
